<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>Buffering</PackageId>
        <Title>Buffering</Title>
        <Authors>Grovre</Authors>
        <Description>Highly efficient, lock-free double buffering library for .NET inspired by the DirectX swap chain. Supports single-writer multiple-reader (SWMR) concurrency with zero allocations, Native AOT, and trimming.</Description>
        <PackageProjectUrl>https://github.com/Grovre/Buffering</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Grovre/Buffering</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>buffering;double-buffering;swap-chain;concurrency;threading;lock-free;swmr;performance;aot;trimming</PackageTags>
        <PackageOutputPath>$(OutputPath)</PackageOutputPath>
        <Copyright>© 2026 Grovre</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Version>1.0.0</Version>
        <LangVersion>latestmajor</LangVersion>

        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <PackageReleaseNotes>Buffering 1.0.0 Release Notes:
- Redesigned architecture to a high-performance, lock-free Single-Writer Multiple-Reader (SWMR) concurrency model.
- Eliminated locking overhead and contention using full memory barriers (Interlocked.MemoryBarrier).
- Removed wrapper allocations (StrongBox&lt;T&gt;) and lock objects for zero-allocation buffer operations and instant construction.
- Introduced decoupled, lightweight handle types: DoubleBufferFrontReader&lt;T&gt; and DoubleBufferBackWriter&lt;T&gt;.
- Configurable swap effects via DoubleBufferSwapEffect (FlipRefOrValue for zero-allocation recycling; CopyRefOrValue for persistent baseline state).
- Built-in pending update detection to avoid redundant swap operations.
- Full Native AOT and Trimming support on .NET 10.0+.</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\Buffering.xml</DocumentationFile>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Testing" />
        <InternalsVisibleTo Include="Benchmarking" />
    </ItemGroup>

</Project>
